if busy_version < "2023-01-15" {
    error("this version of BUSY is not compatible with this build")
}

let mtconf : Config {
    .cflags = [ "/O2", "/MT" ]
}

if (build_mode == `optimized) && (target_toolchain == `msvc) {
    set_defaults(target_toolchain,mtconf)
}

submod qtmini = ../LeanQt (HAVE_COREAPP,HAVE_FILEIO)
submod qtfull = ../LeanQt (HAVE_ITEMVIEWS)


let o2c_conf : Config {
    .include_dirs += [ . .. ]
}

let aofront = [
        ./AoBuilins.cpp
        ./AoRowCol.cpp
        ./AoToken.cpp
        ./AoLexer.cpp
        ./AoTokenType.cpp
        ./AoParser2.cpp
        ./AoAst.cpp
        ./AoValidator2.cpp
    ]

let aoback = [
        ./AoCeeGen.cpp
        ./AoClosureLifter.cpp
    ]

let navigator_moc : Moc {
    .sources += [
        ./AoCodeNavigator2.h
        ./AoProject.h
        ./AoAst.h
    ]
}

let navigator_rcc : Rcc {
    .sources += ./AoCodeNavigator.qrc
}

let navigator* : Executable {
    .configs += [ qtfull.qt_client_config o2c_conf ]
    .sources = [
        ./AoCodeNavigator2.cpp
        ./AoHighlighter2.cpp
        ./AoProject.cpp
        ./AoFileSystem.cpp
    ]
    .sources += aofront;
    .sources += aoback;
    .deps += [ qtfull.libqt navigator_moc navigator_rcc ]
    if target_os == `win32 {
        .deps += qtfull.libqtwinmain
    }
    .name = "AoCodeNavigator"
}

let o2c* : Executable {
    .configs += [ qtmini.qt_client_config o2c_conf ]
    .sources = [
        ./Ao2C.cpp
        ./AoProject2.cpp
    ]
    .sources += aofront;
    .sources += aoback;
    .deps += [ qtmini.libqt ]
    if target_os == `win32 {
        .deps += qtmini.libqtwinmain
    }
}


